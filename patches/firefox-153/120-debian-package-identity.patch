@@ -302,6 +302,35 @@
         }
 
 
+def test_get_build_variables_package_identity_overrides():
+    build_variables = utils.get_build_variables(
+        {
+            "name": "Mercury",
+            "display_name": "Mercury",
+            "vendor": "Mercury",
+            "remoting_name": "com.alex313031.mercury",
+            "build_id": "20260809000000",
+        },
+        "amd64",
+        "153.0.3~build1",
+        package_name="mercury-browser",
+        install_path="usr/lib/mercury",
+    )
+
+    assert build_variables["PKG_NAME"] == "mercury-browser"
+    assert build_variables["PKG_INSTALL_PATH"] == "usr/lib/mercury"
+    assert build_variables["REMOTING_NAME"] == "com.alex313031.mercury"
+
+    langpack_variables = utils.get_build_variables(
+        _APPLICATION_INI_CONTENT_DATA,
+        "all",
+        "153.0.3~build1",
+        package_name_suffix="-l10n-zh-cn",
+        package_name="mercury-browser",
+    )
+    assert langpack_variables["PKG_NAME"] == "mercury-browser-l10n-zh-cn"
+
+
