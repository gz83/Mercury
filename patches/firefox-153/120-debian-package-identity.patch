+def test_mercury_desktop_configuration():
+    assert desktop_file._get_en_US_brand_fluent_filename(
+        "brand.ftl", "release", "mercury"
+    ) == os.path.join(
+        "browser", "branding", "mercury", "locales", "en-US", "brand.ftl"
+    )
+
+    localization = Mock(
+        **{"format_value": lambda message: f"localized-{message}"}
+    )
+    desktop_entry = desktop_file._generate_browser_desktop_entry(
+        {
+            "PKG_NAME": "mercury-browser",
+            "Icon": "mercury-browser",
+            "REMOTING_NAME": "com.alex313031.mercury",
+        },
+        {"en-US": localization},
+        "mercury",
+    )
+
+    assert (
+        "Actions=new-window;new-private-window;open-profile-manager;open-temp-profile;"
+        in desktop_entry
+    )
+    assert "[Desktop Action open-temp-profile]" in desktop_entry
+    assert "Exec=mercury-browser --temp-profile" in desktop_entry
+    assert "Name=localized-desktop-action-open-temp-profile" in desktop_entry
+
