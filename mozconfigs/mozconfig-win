## .mozconfig for compiling Mercury Browser for Windows natively

# Build only Mercury
ac_add_options --enable-application=browser
ac_add_options --disable-artifact-builds

# Build for Windows
ac_add_options --enable-bootstrap
ac_add_options --with-redist
export MOZ_INCLUDE_SOURCE_INFO=1

# Optimization settings
ac_add_options --enable-release
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-debug-js-modules
ac_add_options --disable-tests
ac_add_options --enable-strip
ac_add_options --enable-install-strip
ac_add_options --enable-clang-plugin
ac_add_options --enable-lto
ac_add_options --enable-jemalloc
ac_add_options --enable-optimize="/O2 /clang:-O3 -msse3 -mavx -mtune=sandybridge -mno-gather -mno-scatter /clang:-ffp-contract=off"
ac_add_options --enable-rust-simd
ac_add_options --enable-hardening
export MOZILLA_OFFICIAL=1

# Media settings
ac_add_options --enable-sandbox
ac_add_options --enable-raw
ac_add_options --enable-webrtc
ac_add_options --enable-jxl

# Add-ons
ac_add_options --allow-addon-sideload
ac_add_options --with-unsigned-addon-scopes=app,system

# Client settings
ac_add_options --disable-parental-controls
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --enable-geckodriver
ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --disable-bits-download
export MOZ_REQUIRE_SIGNING=
export MOZ_TELEMETRY_REPORTING=
export MOZ_PACKAGE_JSSHELL=1

# API Keys (Google Location Service key is unavailable on WINNT.)
ac_add_options --with-google-safebrowsing-api-keyfile=@TOPSRCDIR@/ga

# Branding
ac_add_options --with-app-name=mercury
ac_add_options --with-app-basename=Mercury
ac_add_options --with-branding=browser/branding/mercury
ac_add_options --with-distribution-id=com.alex313031

# Autoclobber
if test -n "${MERCURY_L10N_REPACK:-}"; then
    # Keep the compiled en-US binaries while mach changes the UI locale.
    mk_add_options AUTOCLOBBER=
else
    mk_add_options AUTOCLOBBER=1
fi

# Rust release optimization
ac_add_options RUSTC_OPT_LEVEL="3"

# PGO is used only for the complete base build.
if test -z "${MERCURY_L10N_REPACK:-}"; then
    ac_add_options MOZ_PGO=1
fi

# Rust flags; --enable-optimize owns the C/C++ profile.
export RUSTFLAGS="-C target-feature=+sse3,+avx -C llvm-args=-fp-contract=off"
